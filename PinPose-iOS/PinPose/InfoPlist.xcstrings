    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PinPose uses the camera so you can recreate Pinterest photos with the original as an overlay and live pose coaching."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PinPose finds matching photo spots (e.g. beach, café, park) near you and works out golden hour."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PinPose saves your recreated photos to your library."
          }
        }
      }
    }
  },
  "version": "1.0"
}