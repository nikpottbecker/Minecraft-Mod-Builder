    },
    "Bester Pose-Match": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best pose match"
          }
        }
      }
    },
    "Beug dein linkes Knie leicht und dreh es etwas nach innen – das andere Bein trägt das Gewicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your left knee slightly and turn it in a little – the other leg carries the weight."
          }
        }
      }
    },
    "Beug dein rechtes Knie leicht und dreh es etwas nach innen – das andere Bein trägt das Gewicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your right knee slightly and turn it in a little – the other leg carries the weight."
          }
        }
      }
    },
    "Bewegung wirkt natürlich": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movement looks natural"
          }
        }
      }
    },
    "Bewölkter Himmel oder Schatten unter Bäumen/Gebäuden – gleichmäßig und schmeichelhaft.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy sky or shade under trees/buildings – even and flattering."
          }
        }
      }
    },
    "Bild aus Zwischenablage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image from clipboard"
          }
        }
      }
    },
    "Bild gespeichert?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved the image?"
          }
        }
      }
    },
    "Bild hinzufügen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
