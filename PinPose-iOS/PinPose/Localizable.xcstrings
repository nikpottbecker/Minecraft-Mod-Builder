            "state": "translated",
            "value": "Coaching: %@"
          }
        }
      }
    },
    "Das Bild enthält GPS-Daten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture contains GPS data"
          }
        }
      }
    },
    "Das Bild konnte nicht geladen werden. Prüfe deine Internetverbindung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture couldn't be loaded. Check your internet connection."
          }
        }
      }
    },
    "Das Bild konnte nicht gelesen werden. Versuch ein anderes Bild.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture couldn't be read. Try another one."
          }
        }
      }
    },
    "Das Gesicht ist von der Kamera weggedreht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The face is turned away from the camera."
          }
        }
      }
    },
    "Das ist das typische Pinterest-Format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's the typical Pinterest format."
          }
        }
      }
    },
