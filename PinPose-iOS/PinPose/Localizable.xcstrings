        }
      }
    },
    "Bis zu den Knien": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Down to the knees"
          }
        }
      }
    },
    "Bitte teile nachgeshootete Fotos nur, wenn du die Rechte an der Vorlage hast oder sie als Inspiration kennzeichnest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only share recreated photos if you have the rights to the original or credit it as inspiration."
          }
        }
      }
    },
    "Blaue Stunde": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue hour"
          }
        }
      }
    },
    "Blende das Vorlagenbild in der Kamera ein und richte Horizont und Linien daran aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the original in the camera and line up the horizon and lines with it."
          }
        }
      }
    },
