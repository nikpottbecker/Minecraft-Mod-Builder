    "Abbrechen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Abend / Blaue Stunde": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evening / blue hour"
          }
        }
      }
    },
    "Abends oder drinnen mit Lichterkette, Kerzen oder Lampen. Belichtung runter, Handy ruhig halten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the evening or indoors with fairy lights, candles or lamps. Lower the exposure and hold the phone steady."
          }
        }
      }
    },
    "Alle %lld Looks nachgeshootet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All %lld looks recreated"
          }
        }
      }
    },
    "Alles aus einem Bild": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything from one picture"
          }
        }
      }
    },
    "Alles ist scharf – kein Porträtmodus nötig. Live Photo kann aus bleiben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is sharp – no portrait mode needed. Live Photo can stay off."
          }
        }
      }
    },
    "Alles läuft auf deinem iPhone. Kein Konto, keine Uploads.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on your iPhone. No account, no uploads."
          }
        }
      }
    },
    "Allrounder für fast jeden Look": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works for almost any look"
          }
        }
      }
    },
    "Altstadt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old town"
          }
        }
      }
    },
    "Altstadt & Straßen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old town & streets"
          }
        }
      }
    },
    "Am besten im Schatten oder bei leichter Bewölkung – kein hartes Mittagslicht im Gesicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best in the shade or under light clouds – no harsh midday sun on the face."
          }
        }
      }
    },
    "An deinem Ort geht die Sonne heute nicht auf oder unter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun doesn't rise or set at your location today."
          }
        }
      }
    },
    "Analysiere Pose, Licht & Kamera …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzing pose, light & camera …"
          }
        }
      }
    },
    "Arme hoch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms up"
          }
        }
      }
    },
    "Arme verschränkt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arms crossed"
          }
        }
      }
    },
    "Auf Treppe, Mauer oder Bank": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On stairs, a wall or a bench"
          }
        }
      }
    },
    "Auf der Pinterest-Seite wurde kein Bild gefunden. Speichere das Bild stattdessen in Fotos und wähle es dort aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No image found on the Pinterest page. Save the image to Photos instead and choose it there."
