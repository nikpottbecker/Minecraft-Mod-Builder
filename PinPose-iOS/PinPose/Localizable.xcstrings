    "Bäume und Natur": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trees and nature"
          }
        }
      }
    },
    "Ca. 1 Stunde vor Sonnenuntergang (oder nach Sonnenaufgang). Die tiefe Sonne gibt warmes, weiches Licht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 1 hour before sunset (or after sunrise). The low sun gives warm, soft light."
          }
        }
      }
    },
    "Café": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Café"
          }
        }
      }
    },
    "Café- oder Food-Stimmung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Café or food vibe"
          }
        }
      }
    },
    "Coaching ansagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak coaching"
          }
        }
      }
    },
